# Copy to .env and edit. Never commit .env.

# DEMO_MODE=1: unauthenticated admin/monitor API, localhost only, banner shown in UI.
# Set DEMO_MODE=0 for anything reachable from a network; then ADMIN_API_KEY is mandatory.
DEMO_MODE=1
ADMIN_API_KEY=

# SQLite by default. Postgres (compose profile "postgres"):
# DATABASE_URL=postgresql+psycopg://codmav:codmav@postgres:5432/codmav
DATABASE_URL=sqlite:///./data/codmav.db

# Media encryption (AES-256-GCM). Format: "<key_id>:<base64 32-byte key>[,<key_id>:<key>...]"
# Leave empty in DEMO_MODE to auto-generate data/secrets/media.keys on first start.
# Generate one with: python -m backend.app.crypto --new-key
MEDIA_KEYS=
MEDIA_ACTIVE_KEY_ID=

MEDIA_DIR=./data/media
MEDIA_TTL_DAYS=30
LOG_TTL_DAYS=365

# Model bundle to serve (directory name under models/bundles). Empty = built-in placeholder bundle.
MODEL_BUNDLE=

# Upload limits (bytes)
MAX_DOCUMENT_BYTES=10485760
MAX_VIDEO_BYTES=52428800

LOG_LEVEL=INFO
